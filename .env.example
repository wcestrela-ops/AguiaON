# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# ── BANCO DE DADOS ──────────────────────────────
DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco

# ── SEGURANÇA ────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=gere_uma_string_aleatoria_longa_aqui

# Chave legada para acesso direto ao admin (opcional se usar login JWT)
ADMIN_SECRET_KEY=outra_string_aleatoria_aqui

# Criptografa credenciais sensíveis salvas no banco (API keys de SMS, GPSWOX,
# Asaas, Mercado Pago etc. — ver cryptoUtil.ts). Tem um valor padrão de
# fallback, mas TROQUE em produção: se vazar, todas as credenciais salvas
# ficam expostas.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=gere_uma_string_aleatoria_longa_aqui

# ── SUPER ADMIN ──────────────────────────────────
# WhatsApp do SuperAdmin (com DDI, sem espaços/símbolos)
ADMIN_WHATSAPP=5511999999000
ADMIN_EMAIL=admin@seudominio.com

# ── SSO SUBDOMÍNIOS ──────────────────────────────
# Define o domínio pai para o cookie compartilhado entre subdomínios
# Com o ponto na frente: vale para ag-on.com, agenda.ag-on.com, etc.
# Deixe em branco (ou remova) em desenvolvimento local
COOKIE_DOMAIN=.ag-on.com

# ── SERVIDOR ─────────────────────────────────────
PORT=3000

# ── MERCADO PAGO OAUTH ───────────────────────────
MP_CLIENT_ID=seu_client_id_aqui
MP_CLIENT_SECRET=seu_client_secret_aqui
MP_REDIRECT_URI=https://sua-api.com/api/payments/mp-callback

# ── WHITE-LABEL (Fase 4) ─────────────────────────
# Domínio base da plataforma, usado para resolver a empresa pelo subdomínio
# (ex: loja1.ag-on.com → establishment com slug "loja1"). Requer DNS wildcard
# (*.PLATFORM_BASE_DOMAIN) apontando pro servidor. Domínio 100% próprio da
# empresa usa a coluna establishments.custom_domain em vez desta variável.
PLATFORM_BASE_DOMAIN=ag-on.com

# ── BILLING DA PLATAFORMA (Fase 5) ───────────────
# Conta PRÓPRIA da plataforma pra cobrar as empresas (diferente das credenciais
# Asaas/MP que cada empresa cadastra pra cobrar os próprios clientes finais).
PLATFORM_ASAAS_API_KEY=sua_chave_asaas_da_plataforma_aqui
# Fallback manual (copia-e-cola) usado se o Asaas não estiver configurado/falhar
PLATFORM_PIX_KEY_VALUE=sua_chave_pix_da_plataforma_aqui
